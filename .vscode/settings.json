{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "Laborprotokoll bauen",
      "tools": [
        "projekt-neubau"
      ]
    },
    {
      "name": "Laborprotokoll vollstaendig neu bauen",
      "tools": [
        "projekt-neubau"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "projekt-build",
      "command": "/bin/sh",
      "args": [
        "%DIR%/scripts/build.sh"
      ]
    },
    {
      "name": "projekt-neubau",
      "command": "latexmk",
      "args": [
        "-g",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "files.exclude": {
    "**/.tools": true,
    "**/build/*.aux": true,
    "**/build/*.log": true,
    "**/build/*.out": true,
    "**/build/*.toc": true,
    "**/build/*.synctex.gz": true
  }
}
