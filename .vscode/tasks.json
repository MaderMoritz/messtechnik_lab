{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Laborprotokoll: PDF erstellen",
      "type": "process",
      "command": "latexmk",
      "args": [
        "-g",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=${workspaceFolder}/build",
        "${workspaceFolder}/main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
